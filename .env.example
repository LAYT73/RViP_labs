# Общие креды (подхватывает и Compose, и локальный Nest через ConfigModule)
DB_USER=students
DB_PASSWORD=students
DB_NAME=students

# Локальный запуск сервиса на хосте (pnpm start:*:dev)
PORT=3001
DB_HOST=localhost
DB_PORT=55432
STUDENT_SERVICE_URL=http://localhost:3001
# report с хоста закрыт (lab-3); URL нужен только если report поднят вручную в сети
REPORT_SERVICE_URL=http://localhost:3002

# Проброс портов Compose → хост (опционально)
POSTGRES_HOST_PORT=55432
STUDENT_HOST_PORT=3001
GATEWAY_HOST_PORT=3080
STUDENT_PORT=3001
REPORT_PORT=3002
GATEWAY_PORT=3000

# Observability (lab-3)
ELASTIC_APM_ACTIVE=true
ELASTICSEARCH_HOST_PORT=9200
KIBANA_HOST_PORT=5601
APM_HOST_PORT=8200
