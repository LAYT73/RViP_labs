{
  "info": {
    "name": "RViP Lab 5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Enroll student (via gateway)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Test Student\",\n  \"course\": 1\n}"
        },
        "url": "{{gateway}}/api/students"
      }
    },
    {
      "name": "Report JSON via gateway (sync)",
      "request": {
        "method": "GET",
        "url": "{{gateway}}/api/reports/by-course"
      }
    },
    {
      "name": "Export report → queue (via gateway)",
      "request": {
        "method": "GET",
        "url": "{{gateway}}/api/reports/by-course/export"
      }
    },
    {
      "name": "Export via student-service directly",
      "request": {
        "method": "GET",
        "url": "{{student}}/api/reports/by-course/export"
      }
    },
    {
      "name": "Upload CSV to file-storage (manual/debug)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filename\": \"report-by-course.csv\",\n  \"content\": \"course,count\\n1,2\\n\"\n}"
        },
        "url": "{{fileStorage}}/api/files"
      }
    },
    {
      "name": "Get file metadata",
      "request": {
        "method": "GET",
        "url": "{{fileStorage}}/api/files/{{fileId}}"
      }
    },
    {
      "name": "Get file CSV content",
      "request": {
        "method": "GET",
        "url": "{{fileStorage}}/api/files/{{fileId}}/content"
      }
    }
  ],
  "variable": [
    { "key": "gateway", "value": "http://localhost:3080" },
    { "key": "student", "value": "http://localhost:3001" },
    { "key": "fileStorage", "value": "http://localhost:3003" },
    { "key": "fileId", "value": "" }
  ]
}
